<?php

declare(strict_types=1);

$requiredEnvironmentVariable = static function (string $name): string {
    $value = getenv($name);

    if ($value === false) {
        throw new RuntimeException(sprintf('Environment variable %s must be set.', $name));
    }

    return $value;
};

$databasePassword = getenv('DB_PASSWORD');

return [
    'driver' => 'mysql',
    'host' => $requiredEnvironmentVariable('DB_HOST'),
    'port' => (int) (getenv('DB_PORT') ?: '3306'),
    'database' => $requiredEnvironmentVariable('DB_NAME'),
    'username' => $requiredEnvironmentVariable('DB_USERNAME'),
    'password' => $databasePassword === false ? '' : $databasePassword,
    'charset' => 'utf8mb4',
];
